# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit syntax text files
*.cpp text diff=cpp eol=lf
*.hpp text diff=cpp eol=lf
*.c text diff=cpp eol=lf
*.h text diff=cpp eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.pcap binary
*.pcapng binary
*.png binary
*.jpg binary
*.ico binary
*.bin binary
